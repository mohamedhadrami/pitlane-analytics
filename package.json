{
  "name": "pitlane-analytics",
  "version": "1.5.2",
  "private": true,
  "description": "A Next.js application for analyzing pitlane data.",
  "author": "Mohamed Hadrami <mohamedhadrami9@gmail.com>",
  "license": "GNU",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohamedhadrami/pitlane-analytics"
  },
  "bugs": {
    "url": "https://github.com/mohamedhadrami/pitlane-analytics/issues"
  },
  "homepage": "https://pitlane-analytics.vercel.app",
  "keywords": [
    "Next.js",
    "TypeScript",
    "React",
    "Telemetry",
    "Pitlane",
    "Analytics",
    "Formula 1",
    "F1"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "format": "prettier --write .",
    "type-check": "tsc --noEmit",
    "seed": "node -r dotenv/config ./db/ergast/seed.js"
  },
  "dependencies": {
    "@heroui/react": "^2.7.5",
    "@nextui-org/use-infinite-scroll": "^2.2.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@react-stately/data": "^3.12.2",
    "@vercel/postgres": "^0.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^16.4.7",
    "framer-motion": "^12.5.0",
    "lucide-react": "^0.483.0",
    "next": "^15.2.3",
    "next-themes": "^0.4.6",
    "pg": "^8.14.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-fast-marquee": "^1.6.5",
    "react-loader-spinner": "^6.1.6",
    "recharts": "^2.15.1",
    "sonner": "^2.0.1",
    "styled-components": "^6.1.16",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@eslint/eslintrc": "^3",
    "@types/node": "^20",
    "@types/react": "^19.0.11",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.3",
    "prettier": "^3.5.3",
    "tailwindcss": "3",
    "typescript": "^5.8.2",
    "postcss": "^8"
  },
  "eslintConfig": {
    "extends": [
      "next",
      "next/core-web-vitals",
      "prettier"
    ],
    "rules": {
      "semi": [
        "error",
        "never"
      ],
      "quotes": [
        "error",
        "single"
      ]
    }
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,scss,md}": [
      "prettier --write",
      "eslint --fix",
      "git add"
    ]
  }
}
